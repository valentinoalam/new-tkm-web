{
  "name": "my-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "yarn run lint && cross-env NODE_ENV=production vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --fix",
    "serve": "pm2 start server.js --name vue-app"
  },
  "dependencies": {
    "@formkit/vue": "^1.6.5",
    "@iconify/vue": "^4.1.2",
    "@kgierke/formkit-inputs": "^0.3.5",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-table": "^8.20.4",
    "@types/vue-router": "^2.0.0",
    "@vueuse/core": "^10.11.1",
    "apexcharts": "^3.52.0",
    "axios": "^1.7.3",
    "click-outside-vue3": "^4.0.1",
    "cropperjs": "^1.6.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "express": "^4.19.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "normalize.css": "^8.0.1",
    "numeral": "^2.0.6",
    "pinia": "^2.2.1",
    "preline": "^2.4.1",
    "smooth-scrollbar": "^8.8.4",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-eslint": "^1.8.1",
    "vue": "^3.4.37",
    "vue-router": "^4.4.3",
    "vue-time-date-range-picker": "^2.1.2",
    "vue-timeago": "^5.1.3",
    "vue3-apexcharts": "^1.5.3",
    "vue3-perfect-scrollbar": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/js": "^9.8.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.14",
    "@types/node": "^22.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.2",
    "eslint-plugin-vue": "^9.27.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.29"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 80,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "auto"
  },
  "vue": {
    "lintOnSave": "process.env.NODE_ENV !== 'production'"
  }
